# Required
DAO_ADDRESS=0x...
TELEGRAM_BOT_TOKEN=123456:ABC-DEF...

# Public channel (optional — alerts only go to DM subscribers if not set)
TELEGRAM_CHANNEL_ID=@cryptofiat_alerts

# Ethereum RPC — used as fallback when block-watcher is down
RPC_URL=https://mainnet.infura.io/v3/YOUR_KEY
# RPC_WS_URL=wss://mainnet.infura.io/ws/v3/YOUR_KEY

# Block-watcher integration (primary event source)
BLOCK_WATCHER_URL=http://app-workers:3002
REDIS_URL=redis://redis:6379
# contractKeys as configured in block-watcher's watched-addresses.json
BW_ORACLE_KEY=oracle
BW_CDP_KEY=cdp

# Optional
PRICE_ALERT_THRESHOLD_PCT=3
COINGECKO_API_URL=https://api.coingecko.com/api/v3
LOG_LEVEL=info
