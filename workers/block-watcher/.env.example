# Ethereum RPC endpoints
# WebSocket для real-time subscription (предпочтительно)
RPC_WS_URL=wss://eth.rpc.rivet.cloud/6f4e0413c2dd468ebd08f54a5c9c5b82

# HTTP fallback для polling mode
RPC_HTTP_URL=https://eth.rpc.rivet.cloud/6f4e0413c2dd468ebd08f54a5c9c5b82

# Etherscan API для загрузки истории транзакций
ETHERSCAN_API_KEY=YOUR_ETHERSCAN_API_KEY
ETHERSCAN_API_URL=https://api.etherscan.io/v2/api

# Стартовый блок для исторической синхронизации
START_BLOCK=21677704

# Redis
REDIS_URL=redis://redis:6379

# Health status WebSocket server
HEALTH_BROADCAST_PORT=3002

# Logging
LOG_LEVEL=info
