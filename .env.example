# Development environment variables example
# Copy this file to .env and adjust values as needed

# React app will be available at:
# Development LOCAL (local blockchain): http://localhost:3007
# Development (production-like): http://localhost:3008
# Production: http://localhost:8008

# Etherscan API (для получения реальной цены ETH)
# Получить ключ: https://etherscan.io/myapikey
REACT_APP_ETHERSCAN_API_KEY=YOUR_API_KEY_HERE

# Workers Health Check URL
REACT_APP_WORKERS_HEALTH_URL=http://localhost:3002/health

# Web3 RPC endpoint
# Production (default): используется nginx proxy /api/rpc (настроен в nginx.conf)
# Development: можно указать прямой URL или использовать локальную ноду

# Альтернативные публичные RPC endpoints:
# REACT_APP_RPC_URL=https://eth.llamarpc.com
# REACT_APP_RPC_URL=https://ethereum.publicnode.com
# REACT_APP_RPC_URL=https://rpc.ankr.com/eth

# Платные RPC providers (требуют API ключ):
# REACT_APP_RPC_URL=https://eth.rpc.rivet.cloud/YOUR_API_KEY
# REACT_APP_RPC_URL=https://mainnet.infura.io/v3/YOUR_PROJECT_ID
# REACT_APP_RPC_URL=https://eth-mainnet.g.alchemy.com/v2/YOUR_API_KEY

# For local Ethereum node (Ganache, Hardhat, etc)
# REACT_APP_RPC_URL=http://localhost:8545

# Blockchain explorer
# REACT_APP_EXPLORER_URL=https://etherscan.io/

# WalletConnect Project ID
# Get your free project ID at: https://cloud.walletconnect.com/
# Required for /test/wallet page
REACT_APP_WALLETCONNECT_PROJECT_ID=YOUR_WALLETCONNECT_PROJECT_ID

# ===== Docker Compose Variables =====

# Block Watcher settings
START_BLOCK=21677704
ETHERSCAN_API_KEY=YOUR_ETHERSCAN_API_KEY
RPC_WS_URL=wss://ethereum.publicnode.com
RPC_HTTP_URL=https://ethereum.publicnode.com

# Backend API settings
CACHE_TTL=60
LOG_LEVEL=info
