# Server
PORT=3001
NODE_ENV=production

# Ethereum RPC — comma-separated list for automatic failover
RPC_URL=https://eth.llamarpc.com,https://rpc.ankr.com/eth,https://cloudflare-eth.com

# Redis
REDIS_URL=redis://redis:6379

# Cache settings
CACHE_TTL=60
CACHE_ENABLED=true

# Logging
LOG_LEVEL=info

# CORS
CORS_ORIGIN=http://localhost:8008,http://localhost:3000
